  "editor.tokenColorCustomizations": {
    "comments": "#74616D",
    "strings": "#47da0d",
    "keywords": "#FF2DAA",
    "functions": "#F2A0D0",
    "variables": "#FFD0E9",
    "numbers": "#FF1493",
    "types": "#EFA2D1",

    "textMateRules": [
      {
        "scope": [
          "keyword",
          "storage",
          "storage.type",
          "storage.modifier",
          "keyword.control",
          "keyword.operator.new",
          "keyword.operator.expression"
        ],
        "settings": {
          "foreground": "#FF2DAA"
        }
      },
      {
        "scope": [
          "entity.name.function",
          "support.function",
          "meta.function-call",
          "variable.function"
        ],
        "settings": {
          "foreground": "#F4A1D1"
        }
      },
      {
        "scope": [
          "string",
          "string.quoted",
          "string.template",
          "string.regexp"
        ],
        "settings": {
          "foreground": "#A8E68F"
        }
      },
      {
        "scope": [
          "constant.numeric",
          "constant.numeric.css",
          "constant.numeric.decimal",
          "constant.numeric.integer",
          "constant.numeric.float",
          "keyword.other.unit",
          "keyword.other.unit.css"
        ],
        "settings": {
          "foreground": "#FF1493"
        }
      },
      {
        "scope": [
          "variable",
          "variable.other",
          "variable.parameter",
          "meta.object-literal.key"
        ],
        "settings": {
          "foreground": "#FFD0E9"
        }
      },
      {
        "scope": [
          "entity.name.tag",
          "entity.other.attribute-name",
          "support.type.property-name.css",
          "meta.property-name.css"
        ],
        "settings": {
          "foreground": "#FF66C4"
        }
      },
      {
        "scope": [
          "support.type",
          "support.class",
          "entity.name.type",
          "entity.name.class"
        ],
        "settings": {
          "foreground": "#ECA0CF"
        }
      },
      {
        "scope": [
          "constant.language",
          "constant.character",
          "constant.other"
        ],
        "settings": {
          "foreground": "#FF1493"
        }
      },
      {
        "scope": [
          "punctuation",
          "meta.brace",
          "meta.delimiter"
        ],
        "settings": {
          "foreground": "#D881B5"
        }
      },
      {
        "scope": [
          "comment",
          "punctuation.definition.comment"
        ],
        "settings": {
          "foreground": "#74616D",
          "fontStyle": "italic"
        }
      }
    ]
  }
}
