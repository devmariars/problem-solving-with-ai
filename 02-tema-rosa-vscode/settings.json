    "list.activeSelectionBackground": "#33001D",
    "list.activeSelectionForeground": "#FF2DAA",

    "list.inactiveSelectionBackground": "#200012",
    "list.inactiveSelectionForeground": "#FF2DAA",

    "list.focusForeground": "#FF2DAA",
    "list.focusBackground": "#33001D",

    "tree.indentGuidesStroke": "#FF2DAA",
    "tree.inactiveIndentGuidesStroke": "#64133F",

    "titleBar.activeBackground": "#000000",
    "titleBar.activeForeground": "#FF2DAA",
    "titleBar.inactiveBackground": "#000000",
